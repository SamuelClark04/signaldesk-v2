# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Phone / LAN access. Off by default (local-only). When true, the server listens
# on your network and every non-local connection must present the access token.
# Leave LAN_ACCESS_TOKEN empty to get a new random token (and link) each start,
# or set a long secret (24+ chars) to keep the same phone link across restarts.
LAN_ACCESS=false
LAN_ACCESS_TOKEN=

# Alpaca (free IEX feed) - https://app.alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_WS_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_NEWS_WS_URL=wss://stream.data.alpaca.markets/v1beta1/news
# Historical bars for the Setups chart and last closes when the market is closed (REST, same keys).
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Earnings calendar for the equity swing strategy's Earnings Shield (free key: https://finnhub.io/register).
# Without it the shield fails CLOSED: every swing setup is blocked as "earnings date unknown".
FINNHUB_API_KEY=
# Trading API (account data when Stocks mode is LIVE). Live by default; use
# https://paper-api.alpaca.markets with Alpaca Paper keys to test safely.
ALPACA_TRADING_BASE_URL=https://api.alpaca.markets
# Options chains/quotes feed: 'indicative' (free, any Alpaca account) or 'opra'
# (consolidated NBBO; needs the OPRA agreement / a paid data plan).
ALPACA_OPTIONS_FEED=indicative

# Coinbase Advanced Trade public market data (no key required for ticker channel)
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
# Account API (balances when Crypto mode is LIVE). CDP API key: create an ECDSA key
# at https://portal.cdp.coinbase.com. Key name looks like organizations/.../apiKeys/...
# The secret is the full EC private key PEM; write newlines as \n on one line.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Coinbase Advanced fee tier, as fractions per leg (US entry tier: 0.50% maker,
# 0.90% taker). Legs are costed by how they execute: resting limits (entries
# inside the zone: paper, or a live post-only limit at the bid; target exits)
# pay MAKER; stops and market orders pay TAKER + the spread buffer. The crypto
# swing / intraday stop floor is the blended round trip (maker entry + average
# of maker target / taker stop exit) / 0.34R: 3.7% at these rates.
# Unset or invalid: 0.012 taker (conservative), 0.005 maker.
COINBASE_MAKER_FEE=0.005
COINBASE_TAKER_FEE=0.009
COINBASE_SPREAD_BUFFER=0.001

# Email alerts for newly staged setups (optional; without them alerts are only
# logged). Port 465 = implicit TLS, 587 = STARTTLS. Gmail needs an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
# Cloudflare quick tunnel: started with the server when cloudflared is found
# (project root, scripts/ or PATH); its https://....trycloudflare.com address is
# printed on the console and used for email links. TUNNEL=off disables it.
TUNNEL=on
# The address you open SignalDesk at, for the email's "Open Approvals" link.
APP_PUBLIC_URL=http://127.0.0.1:3000/

# Risk gate: max (fees + slippage) as a fraction of 1R
MAX_COST_R=0.35
# Capital cap: max share of the bankroll one position may use (notional, or premium
# for options), however tight the stop. Size = min(risk-based, cap). Default 0.25.
MAX_CAPITAL_ALLOCATION=0.25
