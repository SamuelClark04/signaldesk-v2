# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Phone / LAN access. Off by default (local-only). When true, the server listens
# on your network and every non-local connection must present the access token.
# Leave LAN_ACCESS_TOKEN empty to get a new random token (and link) each start,
# or set a long secret (24+ chars) to keep the same phone link across restarts.
LAN_ACCESS=false
LAN_ACCESS_TOKEN=

# Alpaca (free IEX feed) - https://app.alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_WS_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_NEWS_WS_URL=wss://stream.data.alpaca.markets/v1beta1/news
# Historical bars for the Setups chart and last closes when the market is closed (REST, same keys).
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Earnings calendar for the equity swing strategy's Earnings Shield (free key: https://finnhub.io/register).
# Without it the shield fails CLOSED: every swing setup is blocked as "earnings date unknown".
FINNHUB_API_KEY=
# Trading API (account data when Stocks mode is LIVE). Live by default; use
# https://paper-api.alpaca.markets with Alpaca Paper keys to test safely.
ALPACA_TRADING_BASE_URL=https://api.alpaca.markets

# Coinbase Advanced Trade public market data (no key required for ticker channel)
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
# Account API (balances when Crypto mode is LIVE). CDP API key: create an ECDSA key
# at https://portal.cdp.coinbase.com. Key name looks like organizations/.../apiKeys/...
# The secret is the full EC private key PEM; write newlines as \n on one line.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Risk gate: max (fees + slippage) as a fraction of 1R
MAX_COST_R=0.35
