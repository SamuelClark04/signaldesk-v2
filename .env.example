# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Alpaca (free IEX feed) - https://app.alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_WS_URL=wss://stream.data.alpaca.markets/v2/iex

# Coinbase Advanced Trade public market data (no key required for ticker channel)
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com

# Risk gate: max (fees + slippage) as a fraction of 1R
MAX_COST_R=0.35
